<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="color-scheme" content="light dark">
<title>Брокколи</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
:root{
  --bg:var(--tg-theme-bg-color,#ffffff);
  --bg2:var(--tg-theme-secondary-bg-color,#f1f4f2);
  --text:var(--tg-theme-text-color,#14201a);
  --hint:var(--tg-theme-hint-color,#78867d);
  --accent:#2b8a3e;
  --accent2:#51cf66;
  --accent-soft:rgba(43,138,62,.15);
  --line:rgba(127,140,132,.22);
  --r:20px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0}
body{
  background:var(--bg);color:var(--text);
  font:16px/1.4 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  padding:0 16px calc(110px + env(safe-area-inset-bottom));
  -webkit-font-smoothing:antialiased;
}
button{font:inherit;cursor:pointer;color:inherit}

/* ---------- Герой ---------- */
.hero{
  position:relative;overflow:hidden;margin:14px 0 0;padding:22px 20px 18px;border-radius:26px;color:#fff;
  background:linear-gradient(135deg,#1b6b34 0%,#2f9e44 55%,#69db7c 100%);
}
.hero h1{margin:0;font-size:28px;letter-spacing:-.5px}
.hero p{margin:6px 0 14px;font-size:15px;opacity:.92;max-width:75%}
.hero .deco{position:absolute;right:-6px;top:-10px;font-size:112px;opacity:.28;transform:rotate(12deg);pointer-events:none}
.hero .deco2{position:absolute;right:70px;bottom:-18px;font-size:60px;opacity:.18;transform:rotate(-18deg);pointer-events:none}
.perks{display:flex;gap:8px;flex-wrap:wrap}
.perk{border:0;background:rgba(255,255,255,.2);backdrop-filter:blur(6px);border-radius:999px;padding:7px 12px;font-size:13px;font-weight:600;color:#fff}

.strip{display:flex;align-items:center;gap:10px;width:100%;margin-top:12px;border:1.5px dashed var(--accent);background:var(--accent-soft);
  color:var(--text);border-radius:16px;padding:12px 14px;text-align:left;font-size:14px}
.strip b{color:var(--accent)}
.strip .ico{font-size:22px}

.chips{
  display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;
  position:sticky;top:0;z-index:5;background:var(--bg);
  margin:0 -16px;padding:14px 16px 12px;
}
.chips::-webkit-scrollbar{display:none}
.chip{flex:none;border:0;background:var(--bg2);padding:9px 16px;border-radius:999px;font-size:15px;font-weight:600}
.chip.on{background:var(--accent);color:#fff}

/* ---------- Карточки ---------- */
.plist{display:flex;flex-direction:column;gap:14px}
.pcard{background:var(--bg2);border-radius:24px;overflow:hidden;animation:pop .35s ease both}
.vis{position:relative;height:150px;display:grid;place-items:center;overflow:hidden}
.vis.big{height:230px;border-radius:0 0 28px 28px;margin:0 -16px}
.vis .emo{font-size:84px;filter:drop-shadow(0 8px 10px rgba(0,0,0,.15));animation:float 5s ease-in-out infinite}
.vis.big .emo{font-size:120px}
.vis img{width:100%;height:100%;object-fit:cover}
.badge{position:absolute;left:12px;top:12px;background:rgba(255,255,255,.9);color:#1b6b34;font-weight:800;font-size:12px;padding:5px 10px;border-radius:999px}
.tag{position:absolute;right:12px;top:12px;font-weight:700;font-size:12px;padding:5px 10px;border-radius:999px;color:#fff}
.tag.low{background:#f08c00}
.tag.out{background:#868e96}
.pbody{padding:12px 14px 14px}
.pname{font-weight:800;font-size:19px;letter-spacing:-.2px}
.ptag{color:var(--hint);font-size:14px;margin-top:1px}
.prow{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px}
.price{font-weight:800;font-size:18px;white-space:nowrap}
.price small{color:var(--hint);font-weight:500;font-size:12px}
.add{border:0;border-radius:12px;background:var(--accent);color:#fff;font-weight:700;padding:0 16px;height:42px;white-space:nowrap}
.soldout{color:var(--hint);font-weight:700;font-size:14px}
.stepper{display:flex;align-items:center;justify-content:space-between;height:42px;min-width:136px;background:var(--accent-soft);border-radius:12px}
.stepper button{width:44px;height:42px;border:0;background:transparent;color:var(--accent);font-size:22px;font-weight:700}
.stepper span{font-weight:700;font-size:14px;color:var(--accent);white-space:nowrap}

.ghost{display:block;width:100%;margin-top:14px;border:0;background:var(--bg2);border-radius:16px;padding:14px;font-weight:700;font-size:15px}

/* ---------- Экран товара ---------- */
.top{display:flex;align-items:center;gap:10px;padding:18px 0 12px}
.top h2{margin:0;font-size:23px}
.back{display:none;border:0;background:var(--bg2);width:36px;height:36px;border-radius:50%;font-size:22px}
body.web .back{display:block}
.ptitle{margin:16px 0 2px;font-size:26px;letter-spacing:-.4px}
.psub{color:var(--hint)}
.bigprice{font-size:24px;font-weight:800;margin:12px 0}
.bigprice small{font-size:14px;color:var(--hint);font-weight:500}
.presets{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.presets button{border:0;background:var(--accent-soft);color:var(--accent);font-weight:700;border-radius:12px;padding:11px 16px}
.box{background:var(--bg2);border-radius:var(--r);padding:14px 16px;margin-top:12px}
.box h3{margin:0 0 8px;font-size:15px}
.box p{margin:0;font-size:15px}
.trait{display:flex;justify-content:space-between;align-items:center;padding:5px 0;font-size:15px}
.trait i{display:flex;gap:4px;font-style:normal}
.trait i b{width:14px;height:14px;border-radius:50%;background:var(--line)}
.trait i b.on{background:var(--accent2)}
.cont{display:flex;justify-content:space-between;padding:4px 0;font-size:15px}
.save{color:var(--accent);font-weight:700}

/* ---------- Корзина и оформление ---------- */
.list{display:flex;flex-direction:column;gap:10px}
.line{display:flex;gap:12px;align-items:center;background:var(--bg2);border-radius:var(--r);padding:10px}
.line .mini{width:56px;height:56px;border-radius:14px;display:grid;place-items:center;font-size:30px;flex:none}
.line .info{flex:1;min-width:0}
.line .info b{display:block}
.line .info span{color:var(--hint);font-size:13px}
.line .stepper{min-width:0;width:112px;flex:none}
.sum-box{background:var(--bg2);border-radius:var(--r);padding:14px 16px;margin-top:14px}
.sum-box div{display:flex;justify-content:space-between;padding:4px 0}
.sum-box .tot{font-weight:800;font-size:18px;border-top:1px solid var(--line);margin-top:6px;padding-top:10px}
.note{background:var(--accent-soft);color:var(--accent);border-radius:14px;padding:10px 14px;font-size:14px;margin-top:12px;font-weight:600}
.note.warn{background:rgba(224,49,49,.12);color:#e03131}
.progress{height:8px;border-radius:99px;background:var(--line);margin-top:8px;overflow:hidden}
.progress i{display:block;height:100%;background:var(--accent2);border-radius:99px;transition:width .3s}
.upsell{margin-top:14px}
.upsell b{font-size:14px;color:var(--hint)}
.uprow{display:flex;gap:8px;margin-top:8px}
.up{flex:1;border:1.5px solid var(--line);background:transparent;border-radius:14px;padding:10px;text-align:left;font-weight:700;font-size:14px}
.up small{display:block;color:var(--hint);font-weight:500;margin-top:2px}

label{display:block;font-size:13px;color:var(--hint);margin:16px 0 6px}
input,textarea{
  width:100%;border:1.5px solid transparent;background:var(--bg2);color:var(--text);
  border-radius:14px;padding:14px;font:inherit;font-size:16px;outline:none;
}
input:focus,textarea:focus{border-color:var(--accent)}
.err{border-color:#e03131!important}
textarea{resize:none;min-height:70px}
.opts{display:flex;gap:8px;flex-wrap:wrap}
.opt{border:1.5px solid transparent;background:var(--bg2);border-radius:14px;padding:11px 14px;font-size:14px;font-weight:600;line-height:1.25;text-align:left}
.opt small{display:block;color:var(--hint);font-weight:500}
.opt.on{border-color:var(--accent);background:var(--accent-soft)}

/* ---------- Инфо ---------- */
.trust{display:flex;gap:12px;align-items:flex-start;padding:10px 0}
.trust .ic{font-size:26px}
.trust b{display:block}
.trust span{color:var(--hint);font-size:14px}
details{background:var(--bg2);border-radius:16px;padding:12px 14px;margin-top:8px}
summary{font-weight:700;cursor:pointer}
details p{margin:8px 0 0;font-size:14px;color:var(--hint)}

.empty{text-align:center;padding:70px 0;color:var(--hint)}
.empty .big{font-size:68px}
.empty .btn{margin-top:14px;border:0;background:var(--accent);color:#fff;border-radius:12px;padding:12px 22px;font-weight:700}

#bar{position:fixed;left:0;right:0;bottom:0;padding:12px 16px calc(12px + env(safe-area-inset-bottom));background:var(--bg);border-top:1px solid var(--line)}
#bar[hidden]{display:none}
#barbtn{width:100%;height:50px;border:0;border-radius:14px;background:var(--accent);color:#fff;font-weight:700;font-size:17px}
#barbtn:disabled{opacity:.5}
#toast{position:fixed;left:50%;top:calc(14px + env(safe-area-inset-top));transform:translate(-50%,-80px);background:rgba(20,32,26,.92);color:#fff;
  padding:10px 16px;border-radius:14px;font-size:14px;font-weight:600;transition:transform .25s;z-index:20;max-width:90%;text-align:center}
#toast.show{transform:translate(-50%,0)}

@keyframes pop{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@keyframes float{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-6px) rotate(3deg)}}
@media (prefers-reduced-motion:reduce){.vis .emo,.pcard{animation:none}}
</style>
</head>
<body>
<div id="app"><div class="empty"><div class="big">🥦</div><p>Загружаем витрину…</p></div></div>
<div id="bar" hidden><button id="barbtn"></button></div>
<div id="toast"></div>

<script>
(function(){
const tg = window.Telegram && window.Telegram.WebApp;
const inTG = !!(tg && tg.platform && tg.platform !== 'unknown');
if(!inTG) document.body.classList.add('web');
if(tg){
  try{ tg.ready(); tg.expand(); }catch(e){}
  try{ tg.setHeaderColor('secondary_bg_color'); }catch(e){}
  try{ tg.disableVerticalSwipes(); }catch(e){}
}

const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const tap = t => { try{ tg.HapticFeedback.impactOccurred(t||'light'); }catch(e){} };
const notify = t => { try{ tg.HapticFeedback.notificationOccurred(t); }catch(e){} };
let toastT;
function toast(msg){ const t = $('#toast'); t.textContent = msg; t.classList.add('show'); clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('show'), 2200); }
const store = {
  get(k, d){ try{ const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; }catch(e){ return d; } },
  set(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
};

let C = null;                 // каталог
let stock = {};               // остатки с сервера (необязательно)
let cart = {};                // id -> количество
let view = 'catalog';         // catalog | product | cart | checkout | info
let openId = null;
let cat = 'all';
let stack = [];
let form = Object.assign({name:'', phone:'', address:'', comment:'', pay:'', date:'', slot:'', promo:''}, store.get('form', {}));
form.comment = '';
const saveForm = () => store.set('form', {name:form.name, phone:form.phone, address:form.address, pay:form.pay, promo:form.promo});

/* ---------- Формат и расчёты (округление совпадает с ботом) ---------- */
const R = x => Math.floor(x + 0.5 + 1e-9);
const money = n => new Intl.NumberFormat('ru-RU').format(R(n)) + '\u00A0' + C.shop.currency;
const num = q => String(Math.round(q*100)/100).replace('.', ',');
const qtyTxt = (p, q) => num(q) + '\u00A0' + p.unit;
const unitLabel = p => p.pack ? p.unit + ' ' + p.pack : p.unit;
const P = id => C.products.find(p => p.id === id);
const lineSum = (p, q) => R(p.price * q);
const sub = () => Object.entries(cart).reduce((s,[id,q]) => s + lineSum(P(id), q), 0);
const delivery = () => { const s = sub(); return s === 0 || s >= C.shop.free_from ? 0 : C.shop.delivery_fee; };
const total = () => sub() + delivery();
const count = () => Object.keys(cart).length;
const saveCart = () => store.set('cart', cart);

/* ---------- Наличие ---------- */
function avail(p){
  if(p.contains){
    let m = Infinity;
    p.contains.forEach(c => { const s = stock[c.id]; if(s !== undefined) m = Math.min(m, Math.floor((s + 1e-9) / c.qty)); });
    return m;
  }
  return stock[p.id] !== undefined ? stock[p.id] : Infinity;
}
const soldOut = p => p.available === false || avail(p) < (p.min || p.step || 1) - 1e-9;
function clampCart(){
  Object.keys(cart).forEach(id => {
    const p = P(id);
    if(!p || soldOut(p)){ delete cart[id]; return; }
    const cap = Math.min(p.max || 30, avail(p));
    if(cart[id] > cap + 1e-9) cart[id] = Math.floor(cap / (p.step || 1) + 1e-9) * (p.step || 1);
    if(cart[id] <= 0) delete cart[id];
  });
  saveCart();
}

/* ---------- Слоты доставки (та же логика, что в боте) ---------- */
const MONTHS = ['янв','фев','мар','апр','мая','июн','июл','авг','сен','окт','ноя','дек'];
const WD = ['Пн','Вт','Ср','Чт','Пт','Сб','Вс'];
function tzNow(){
  try{ return new Date(new Date().toLocaleString('en-US', {timeZone: C.shop.tz})); }catch(e){ return new Date(); }
}
const isoDate = d => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
function dayLabel(d, i){
  const base = d.getDate() + ' ' + MONTHS[d.getMonth()];
  if(i === 0) return 'Сегодня, ' + base;
  if(i === 1) return 'Завтра, ' + base;
  return WD[(d.getDay()+6)%7] + ', ' + base;
}
function slotOptions(){
  const D = C.shop.delivery, now = tzNow(), out = [];
  for(let i = 0; i <= D.days_ahead; i++){
    const day = new Date(now.getFullYear(), now.getMonth(), now.getDate() + i);
    if((D.days_off || []).includes((day.getDay()+6)%7)) continue;
    const slots = D.slots.filter(s => {
      if(i > 0) return true;
      if(now.getHours() >= D.cutoff_hour) return false;
      return parseInt(s, 10) >= now.getHours() + D.lead_hours;
    });
    if(slots.length) out.push({date: isoDate(day), label: dayLabel(day, i), slots});
  }
  return out;
}
function ensureSlot(){
  const opts = slotOptions();
  if(!opts.length) return opts;
  if(!opts.some(o => o.date === form.date)) form.date = opts[0].date;
  const day = opts.find(o => o.date === form.date);
  if(!day.slots.includes(form.slot)) form.slot = day.slots[0];
  if(!C.shop.payments.some(p => p.id === form.pay)) form.pay = C.shop.payments[0].id;
  return opts;
}

/* ---------- Нижняя кнопка Telegram ---------- */
const Main = {
  set(text, visible, active){
    if(inTG){
      tg.MainButton.setParams({text, color:'#2b8a3e', text_color:'#ffffff', is_active:active, is_visible:visible});
    }else{
      $('#bar').hidden = !visible;
      $('#barbtn').textContent = text;
      $('#barbtn').disabled = !active;
    }
  }
};
function syncChrome(){
  const s = sub();
  if(view === 'catalog' || view === 'product' || view === 'info'){
    Main.set('🛒 Корзина · ' + money(s), count() > 0, true);
  }else if(view === 'cart'){
    if(s < C.shop.min_order) Main.set('Минимальный заказ ' + money(C.shop.min_order), count() > 0, false);
    else Main.set('Оформить · ' + money(total()), count() > 0, true);
  }else{
    Main.set('Отправить заказ · ' + money(total()), true, true);
  }
  if(inTG){ view === 'catalog' ? tg.BackButton.hide() : tg.BackButton.show(); }
}

/* ---------- Компоненты ---------- */
function stockTag(p){
  if(soldOut(p)) return '<span class="tag out">Нет в наличии</span>';
  const a = avail(p);
  if(a !== Infinity && a <= 10) return '<span class="tag low">Осталось ' + num(a) + ' ' + p.unit + '</span>';
  return '';
}
function visHTML(p, big){
  const bg = 'linear-gradient(145deg,' + (p.color || '#d8f5a2') + ',' + (p.color2 || '#69db7c') + ')';
  const inner = p.image ? '<img src="' + esc(p.image) + '" alt="' + esc(p.name) + '" loading="lazy">' : '<span class="emo">' + p.emoji + '</span>';
  const badge = p.badge ? '<span class="badge">' + esc(p.badge) + '</span>' : '';
  return '<div class="vis' + (big ? ' big' : '') + '" style="background:' + bg + '">' + inner + badge + stockTag(p) + '</div>';
}
function ctrlHTML(p){
  const q = cart[p.id];
  if(!q) return '<button class="add" data-a="inc" data-id="' + p.id + '">В корзину</button>';
  return '<div class="stepper"><button data-a="dec" data-id="' + p.id + '">−</button><span>' + qtyTxt(p, q) +
         '</span><button data-a="inc" data-id="' + p.id + '">+</button></div>';
}
function cardHTML(p){
  return '<article class="pcard" data-a="open" data-id="' + p.id + '">' + visHTML(p) +
    '<div class="pbody"><div class="pname">' + esc(p.name) + '</div><div class="ptag">' + esc(p.tagline || '') + '</div>' +
    '<div class="prow"><div class="price">' + money(p.price) + '<small> / ' + esc(unitLabel(p)) + '</small></div>' +
    (soldOut(p) ? '<span class="soldout">Нет в наличии</span>' : ctrlHTML(p)) + '</div></div></article>';
}
const listHTML = () => C.products.filter(p => cat === 'all' || p.cat === cat).map(cardHTML).join('');

function stripHTML(){
  const w = C.shop.welcome_promo;
  let h = '';
  if(w) h += '<button class="strip" data-a="usepromo" data-code="' + esc(w.code) + '"><span class="ico">🎁</span><span>Первый заказ: промокод <b>' +
    esc(w.code) + '</b> — скидка ' + w.percent + '%<br><small style="color:var(--hint)">Нажмите, чтобы применить</small></span></button>';
  return h;
}
function repeatHTML(){
  const last = store.get('last', null);
  if(count() || !last || !last.length) return '';
  const items = last.filter(i => P(i.id) && !soldOut(P(i.id)));
  if(!items.length) return '';
  return '<button class="ghost" data-a="repeat">🔁 Повторить прошлый заказ (' + items.length + ')</button>';
}

function catalogHTML(){
  const chips = [{id:'all', title:'🥬 Всё'}].concat(C.categories)
    .map(c => '<button class="chip' + (c.id === cat ? ' on' : '') + '" data-a="cat" data-cat="' + c.id + '">' + esc(c.title) + '</button>').join('');
  const perks = C.shop.trust.map(t => '<button class="perk" data-a="go" data-go="info">' + t.icon + ' ' + esc(t.title) + '</button>').join('');
  return '<div class="hero"><span class="deco">🥦</span><span class="deco2">🌿</span><h1>🥦 ' + esc(C.shop.name) + '</h1><p>' +
    esc(C.shop.tagline) + '</p><div class="perks">' + perks + '</div></div>' +
    stripHTML() + repeatHTML() + '<div class="chips">' + chips + '</div><div class="plist" id="plist">' + listHTML() + '</div>' +
    '<button class="ghost" data-a="go" data-go="info">ℹ️ Доставка, гарантия и вопросы</button>';
}

function dots(v){ let h = ''; for(let i = 1; i <= 5; i++) h += '<b class="' + (i <= v ? 'on' : '') + '"></b>'; return h; }

function productHTML(p){
  const q = cart[p.id] || 0;
  const so = soldOut(p);
  let h = '<div class="top"><button class="back" data-a="back">‹</button></div>';
  h = '<div class="top" style="padding-bottom:0"><button class="back" data-a="back">‹</button></div>' + visHTML(p, true);
  h += '<h1 class="ptitle">' + esc(p.name) + '</h1><div class="psub">' + esc(p.tagline || '') + '</div>';
  h += '<div class="bigprice">' + money(p.price) + ' <small>/ ' + esc(unitLabel(p)) + '</small></div>';
  if(so){
    h += '<div class="note warn">Сейчас нет в наличии</div>';
  }else{
    const presets = p.unit === 'кг' ? [0.5, 1, 2] : [1, 2, 3];
    h += '<div class="presets">' + presets.map(n => '<button data-a="preset" data-id="' + p.id + '" data-n="' + n + '">+ ' + qtyTxt(p, n) + '</button>').join('') + '</div>';
    if(q) h += '<div class="prow" style="margin-top:0"><span class="psub">В корзине:</span>' + ctrlHTML(p) + '</div>';
  }
  if(p.contains){
    let parts = 0;
    const rows = p.contains.map(c => { const b = P(c.id); parts += lineSum(b, c.qty);
      return '<div class="cont"><span>' + b.emoji + ' ' + esc(b.name) + '</span><b>' + qtyTxt(b, c.qty) + '</b></div>'; }).join('');
    const save = parts - p.price;
    h += '<div class="box"><h3>Что внутри</h3>' + rows + (save > 0 ? '<div class="cont save"><span>Выгода против покупки по отдельности</span><span>' + money(save) + '</span></div>' : '') + '</div>';
  }
  h += '<div class="box"><h3>О сорте</h3><p>' + esc(p.desc || '') + '</p></div>';
  if(p.traits && p.traits.length) h += '<div class="box"><h3>Характер</h3>' + p.traits.map(t => '<div class="trait"><span>' + esc(t[0]) + '</span><i>' + dots(t[1]) + '</i></div>').join('') + '</div>';
  if(p.use) h += '<div class="box"><h3>Подойдёт для</h3><p>' + esc(p.use) + '</p></div>';
  if(p.idea) h += '<div class="box"><h3>👩‍🍳 Идея на ужин</h3><p>' + esc(p.idea) + '</p></div>';
  if(p.kcal) h += '<div class="box"><h3>Пищевая ценность</h3><p>≈' + p.kcal + ' ккал на 100 г, много клетчатки и витамина C</p></div>';
  return h;
}

function summaryHTML(){
  const s = sub(), d = delivery();
  return '<div class="sum-box"><div><span>Товары</span><span>' + money(s) + '</span></div><div><span>Доставка</span><span>' +
    (d ? money(d) : 'бесплатно') + '</span></div><div class="tot"><span>Итого</span><span>' + money(s + d) + '</span></div></div>';
}

function upsellHTML(){
  if(sub() >= C.shop.free_from) return '';
  const c = C.products.filter(p => !soldOut(p) && !cart[p.id] && !p.contains).slice(0, 2);
  if(!c.length) return '';
  return '<div class="upsell"><b>Добавьте к заказу</b><div class="uprow">' + c.map(p => {
    const n = p.min || p.step || 1;
    return '<button class="up" data-a="inc" data-id="' + p.id + '">' + p.emoji + ' ' + esc(p.name) + '<small>+' + qtyTxt(p, n) + ' · ' + money(lineSum(p, n)) + '</small></button>';
  }).join('') + '</div></div>';
}

function cartHTML(){
  const head = '<div class="top"><button class="back" data-a="back">‹</button><h2>Корзина</h2></div>';
  if(!count()) return head + '<div class="empty"><div class="big">🧺</div><p>Корзина пока пуста</p><button class="btn" data-a="back">Выбрать брокколи</button></div>';
  const lines = Object.entries(cart).map(([id, q]) => { const p = P(id);
    const bg = 'linear-gradient(145deg,' + (p.color || '#d8f5a2') + ',' + (p.color2 || '#69db7c') + ')';
    return '<div class="line"><div class="mini" style="background:' + bg + '">' + p.emoji + '</div><div class="info"><b>' + esc(p.name) +
      '</b><span>' + money(lineSum(p, q)) + '</span></div><div class="stepper"><button data-a="dec" data-id="' + id + '">−</button><span>' +
      qtyTxt(p, q) + '</span><button data-a="inc" data-id="' + id + '">+</button></div></div>'; }).join('');
  const s = sub();
  let note = '';
  if(s < C.shop.min_order) note = '<div class="note warn">Минимальный заказ — ' + money(C.shop.min_order) + '. Добавьте ещё на ' + money(C.shop.min_order - s) + '</div>';
  else if(s < C.shop.free_from){
    const pct = Math.min(100, Math.round(s / C.shop.free_from * 100));
    note = '<div class="note">Ещё ' + money(C.shop.free_from - s) + ' до бесплатной доставки 🚚<div class="progress"><i style="width:' + pct + '%"></i></div></div>';
  }else note = '<div class="note">🎉 Доставка бесплатная</div>';
  return head + '<div class="list">' + lines + '</div>' + note + upsellHTML() + summaryHTML();
}

function checkoutHTML(){
  const opts = ensureSlot();
  const day = opts.find(o => o.date === form.date);
  const dates = opts.map(o => '<button class="opt' + (o.date === form.date ? ' on' : '') + '" data-a="date" data-date="' + o.date + '">' + esc(o.label) + '</button>').join('');
  const slots = day ? day.slots.map(s => '<button class="opt' + (s === form.slot ? ' on' : '') + '" data-a="slot" data-slot="' + esc(s) + '">' + esc(s) + '</button>').join('') : '';
  const pays = C.shop.payments.map(p => '<button class="opt' + (p.id === form.pay ? ' on' : '') + '" data-a="pay" data-pay="' + p.id + '">' + esc(p.title) + '<small>' + esc(p.hint || '') + '</small></button>').join('');
  return '<div class="top"><button class="back" data-a="back">‹</button><h2>Оформление</h2></div>' +
    '<label>Имя</label><input name="name" autocomplete="name" placeholder="Как к вам обращаться" value="' + esc(form.name) + '">' +
    '<label>Телефон</label><input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="Номер телефона" value="' + esc(form.phone) + '">' +
    '<label>Адрес доставки</label><input name="address" autocomplete="street-address" placeholder="Улица, дом, квартира" value="' + esc(form.address) + '">' +
    '<label>Когда привезти</label><div class="opts">' + dates + '</div><div class="opts" style="margin-top:8px">' + slots + '</div>' +
    '<label>Оплата</label><div class="opts">' + pays + '</div>' +
    '<label>Промокод (если есть)</label><input name="promo" autocapitalize="characters" placeholder="Например, FIRST10" value="' + esc(form.promo) + '">' +
    '<label>Комментарий</label><textarea name="comment" placeholder="Домофон, этаж, пожелания курьеру…">' + esc(form.comment) + '</textarea>' +
    summaryHTML() + '<p class="psub" style="font-size:13px;margin:8px 4px 0">Скидку по промокоду подтвердим в чате после отправки заказа.</p>';
}

function infoHTML(){
  const D = C.shop.delivery;
  const trust = C.shop.trust.map(t => '<div class="trust"><span class="ic">' + t.icon + '</span><div><b>' + esc(t.title) + '</b><span>' + esc(t.text) + '</span></div></div>').join('');
  const faq = C.shop.faq.map(f => '<details><summary>' + esc(f.q) + '</summary><p>' + esc(f.a) + '</p></details>').join('');
  return '<div class="top"><button class="back" data-a="back">‹</button><h2>О магазине</h2></div>' + trust +
    '<div class="box"><h3>🚚 Доставка</h3><p>' + esc(D.note || '') + '. Бесплатно от ' + money(C.shop.free_from) + ', иначе ' + money(C.shop.delivery_fee) +
    '.<br>Окна: ' + D.slots.map(esc).join(', ') + '.<br>Минимальный заказ — ' + money(C.shop.min_order) + '.</p></div>' +
    '<h3 style="margin:18px 0 0">Частые вопросы</h3>' + faq +
    (C.shop.support ? '<button class="ghost" data-a="support">💬 Написать в поддержку</button>' : '');
}

/* ---------- Рендер и навигация ---------- */
function render(keep){
  const y = window.scrollY;
  const app = $('#app');
  app.innerHTML = view === 'catalog' ? catalogHTML() : view === 'product' ? productHTML(P(openId)) :
                  view === 'cart' ? cartHTML() : view === 'checkout' ? checkoutHTML() : infoHTML();
  if(view === 'checkout'){
    app.querySelectorAll('input,textarea').forEach(el => el.addEventListener('input', () => {
      if(el.name === 'promo'){ el.value = el.value.toUpperCase(); }
      form[el.name] = el.value; el.classList.remove('err'); saveForm();
    }));
  }
  window.scrollTo(0, keep ? y : 0);
  syncChrome();
}
function refresh(){
  if(view === 'catalog'){
    const l = $('#plist'); if(l) l.innerHTML = listHTML();
    syncChrome();
  }else render(true);
}
function go(v, id){
  stack.push({view, openId, cat, y: window.scrollY});
  view = v; if(id) openId = id;
  render();
}
function back(){
  const s = stack.pop();
  if(!s){ view = 'catalog'; render(); return; }
  view = s.view; openId = s.openId; cat = s.cat;
  render(); window.scrollTo(0, s.y);
}

function change(id, dir, amount){
  const p = P(id); const cur = cart[id] || 0;
  const step = p.step || 1, min = p.min || step, max = Math.min(p.max || 30, avail(p));
  let q;
  if(amount){ q = cur + amount; }
  else if(dir > 0){ q = cur ? cur + step : min; }
  else { q = cur - step; if(q < min - 1e-9) q = 0; }
  q = Math.round(q * 100) / 100;
  if(q > max + 1e-9){
    notify('error');
    toast(max >= min ? 'Максимум — ' + qtyTxt(p, max) : 'Нет в наличии');
    return;
  }
  if(q <= 0) delete cart[id]; else cart[id] = q;
  saveCart(); tap('light');
  if(view === 'cart' && !count()) render(); else refresh();
}

/* ---------- Отправка заказа ---------- */
function validate(){
  const bad = [];
  if(form.name.trim().length < 2) bad.push('name');
  if(form.phone.replace(/\D/g, '').length < 10) bad.push('phone');
  if(form.address.trim().length < 5) bad.push('address');
  return bad;
}
function submit(){
  const bad = validate();
  if(bad.length){
    notify('error');
    bad.forEach(n => { const el = document.querySelector('[name="' + n + '"]'); if(el) el.classList.add('err'); });
    const first = document.querySelector('[name="' + bad[0] + '"]');
    if(first){ first.scrollIntoView({block:'center', behavior:'smooth'}); first.focus(); }
    return;
  }
  ensureSlot();
  const items = Object.entries(cart).map(([id, qty]) => ({id, qty}));
  const payload = {
    items, name: form.name.trim(), phone: form.phone.trim(), address: form.address.trim(),
    comment: form.comment.trim(), pay: form.pay, date: form.date, slot: form.slot, promo: form.promo.trim().toUpperCase()
  };
  notify('success');
  store.set('last', items);
  cart = {}; saveCart();
  if(inTG) tg.sendData(JSON.stringify(payload));   // бот получит заказ, Mini App закроется
  else alert('Предпросмотр вне Telegram. Бот получит:\n\n' + JSON.stringify(payload, null, 2));
}
function onMain(){
  if(view === 'catalog' || view === 'product' || view === 'info') go('cart');
  else if(view === 'cart'){ if(sub() >= C.shop.min_order) go('checkout'); }
  else submit();
}

/* ---------- События ---------- */
document.addEventListener('click', e => {
  const el = e.target.closest('[data-a]');
  if(!el) return;
  const a = el.dataset.a, id = el.dataset.id;
  if(a === 'inc') change(id, 1);
  else if(a === 'dec') change(id, -1);
  else if(a === 'preset') change(id, 1, parseFloat(el.dataset.n));
  else if(a === 'open') go('product', id);
  else if(a === 'go') go(el.dataset.go);
  else if(a === 'cat'){ cat = el.dataset.cat; tap('light'); render(); }
  else if(a === 'back') back();
  else if(a === 'pay'){ form.pay = el.dataset.pay; saveForm(); tap('light'); render(true); }
  else if(a === 'date'){ form.date = el.dataset.date; tap('light'); render(true); }
  else if(a === 'slot'){ form.slot = el.dataset.slot; tap('light'); render(true); }
  else if(a === 'usepromo'){ form.promo = el.dataset.code; saveForm(); notify('success'); toast('Промокод ' + form.promo + ' добавлен'); }
  else if(a === 'repeat'){
    (store.get('last', []) || []).forEach(i => { const p = P(i.id); if(p && !soldOut(p)) cart[i.id] = Math.min(i.qty, p.max || 30, avail(p)); });
    saveCart(); tap('light'); refresh(); render(true);
  }
  else if(a === 'support'){
    const url = 'https://t.me/' + C.shop.support.replace('@', '');
    if(inTG && tg.openTelegramLink) tg.openTelegramLink(url); else window.open(url, '_blank');
  }
  else if(a === 'retry') boot();
});
if(inTG){ tg.MainButton.onClick(onMain); tg.BackButton.onClick(back); }
else{ $('#barbtn').addEventListener('click', onMain); }

/* ---------- Старт ---------- */
function loadStock(){
  if(!C.shop.api) return Promise.resolve();
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), 3500);
  return fetch(C.shop.api.replace(/\/$/, '') + '/api/stock', {signal: ctrl.signal})
    .then(r => r.json()).then(j => { stock = j || {}; }).catch(() => {}).then(() => clearTimeout(t));
}
function boot(){
  $('#app').innerHTML = '<div class="empty"><div class="big">🥦</div><p>Загружаем витрину…</p></div>';
  fetch('catalog.json?v=' + Date.now()).then(r => { if(!r.ok) throw new Error('http'); return r.json(); })
    .then(j => {
      C = j; document.title = C.shop.name;
      cart = store.get('cart', {}) || {};
      Object.keys(cart).forEach(id => { if(!P(id)) delete cart[id]; });
      render();
      loadStock().then(() => { clampCart(); refresh(); });
    })
    .catch(() => {
      $('#app').innerHTML = '<div class="empty"><div class="big">😕</div><p>Не удалось загрузить витрину</p><button class="btn" data-a="retry">Повторить</button></div>';
    });
}
boot();
})();
</script>
</body>
</html>
